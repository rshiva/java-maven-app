#!/usr/bin/env groovy

pipeline {
    agent none
    parameters{
        choice(name: 'VERSION', choices: ['1.1','1.2','1.3'], description: "select a version")
        boolean(name: 'executeTests', defaultValue: true, description: "select a version")
    }
    tools{
        maven 'maven-3.9' 
    }
    stages{
        stage('init'){
            steps{
                script{
                    gv = load 'script.groovy' // to load a groovy script file
                }
            }
        }
    }
    stages {
        stage('build') {
            steps {
                script {
                    echo "Building the application..."
                    sh 'mvn install'
                }
            }
        }
        stage('test') {
            when{
                expression{
                    BRANCH_NAME == 'dev' || BRANCH_NAME == 'master'
                }
            }
            when{
                expression{
                    params.executeTests == true
                }
            }
            steps {
                script {
                    echo "Testing the application..."
                }
            }
        }
        stage('deploy') {
            input{
                message "select the environment to deploy"
                ok "Done"
                parameters{
                    choice(name: 'ONE', choices: ['dev','staging','production'], description: "select a version")
                    choice(name: 'TWO', choices: ['dev','staging','production'], description: "select a version")
                }

            }
            steps {
                withCredentials([
                    usernamePassword(credentials: 'server-cred',usernameVariable: USER, passwordVariable: PWD)
                ])
                script {
                    echo "Deploying the application..."
                    sh "echo some user ${USER} ${PWD}"
                    echo "deploying version ${params.VERSION}"
                    echo "deploying in ${ONE} ${TWO}"
                }
            }
        }
    }
}
